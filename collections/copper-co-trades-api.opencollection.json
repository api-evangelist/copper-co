                "type": "query",
                "description": "When true, includes trade actions in the response"
              },
              {
                "name": "includeCollateralTransactions",
                "value": "",
                "type": "query",
                "description": "When true, includes collateral transactions in the response"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip for pagination"
              },
              {
                "name": "isOpen",
                "value": "",
                "type": "query",
                "description": "When true, returns only open trades; when false, returns only closed trades"
              }
            ]
