          "info": {
            "name": "Get Trades",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.copper.co/platform/trades",
            "params": [
              {
                "name": "organizationId",
                "value": "",
                "type": "query",
                "description": "Organization ID to scope the search"
              },
              {
                "name": "tradeId",
                "value": "",
                "type": "query",
                "description": "Filter by trade ID"
              },
              {
                "name": "tradeReferenceId",
                "value": "",
                "type": "query",
                "description": "Filter by external trade reference ID"
              },
              {
                "name": "effectiveDateFrom",
                "value": "",
                "type": "query",
                "description": "Filter trades with effective date on or after this. Format is unix timestamp (ms)"
              },
              {
                "name": "effectiveDateTo",
                "value": "",
                "type": "query",
                "description": "Filter trades with effective date on or before this. Format is unix timestamp (ms)"
              },
              {
                "name": "maturityDateFrom",
                "value": "",
                "type": "query",
                "description": "Filter trades with maturity date on or after this. Format is unix timestamp (ms)"
              },
              {
                "name": "maturityDateTo",
                "value": "",
                "type": "query",
                "description": "Filter trades with maturity date on or before this. Format is unix timestamp (ms)"
              },
              {
                "name": "tradeSide",
                "value": "",
                "type": "query",
                "description": "Filter by trade side (buy, sell, not-applicable)"
              },
              {
                "name": "tradeStatus",
                "value": "active",
                "type": "query",
                "description": "Filter by trade status"
              },
              {
                "name": "tradeType",
                "value": "forward",
                "type": "query",
                "description": "Filter by trade type (forward, option, swap, other, not-applicable)"
              },
              {
                "name": "counterpartyId",
                "value": "",
                "type": "query",
                "description": "Filter by counterparty ID (creator or acceptor)"
              },
              {
                "name": "includeCollateral",
                "value": "",
                "type": "query",
                "description": "When true, includes collateral details in the response"
              },
              {
                "name": "includeCounterparties",
                "value": "",
                "type": "query",
                "description": "When true, includes counterparty details in the response"
              },
              {
                "name": "includeTradeActions",
